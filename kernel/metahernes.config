# metahernes çekirdek parçası — tinyconfig üzerine uygulanır.
# Hedef: QEMU/KVM microVM (virtio), bash + ağ + ssh + Claude Code.

CONFIG_64BIT=y
CONFIG_LOCALVERSION="-metahernes"
CONFIG_DEFAULT_HOSTNAME="metahernes"
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_EARLY_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y
CONFIG_POSIX_TIMERS=y
CONFIG_FHANDLE=y
CONFIG_ELF_CORE=y
CONFIG_BASE_FULL=y
CONFIG_RSEQ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_FSNOTIFY=y
CONFIG_FILE_LOCKING=y
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# PCI + virtio
CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

# Ağ
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=n

# Ana makineden klasör paylaşımı (virtio-9p)
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# Kripto (getrandom, TLS userspace'te; çekirdek tarafı minimum)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_CRC32C=y

# Gereksizler kapalı
CONFIG_MODULES=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_USB_SUPPORT=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n

# Temiz kapanış (QEMU'dan çıkış için ACPI poweroff)
CONFIG_ACPI=y
CONFIG_MAGIC_SYSRQ=y

# İç içe sanallaştırma: metahernes içinde de metahernes-vmm çalışabilsin (test ve geliştirme)
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
# metahernes-vmm virtio-mmio aygıtları
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# 5 seviyeli sayfalama kapalı: açıcı (decompressor) 1 MiB altı trambolin kullanmaz, daha basit önyükleme
CONFIG_X86_5LEVEL=n
# KVM misafir iyileştirmeleri (kvmclock, paravirt)
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
